<!--
    O arquivo strings.xml é o local centralizado para armazenar todos os textos do aplicativo.
    Isso facilita a manutenção e permite a tradução do app para outros idiomas (internacionalização)
    sem a necessidade de alterar o código-fonte Kotlin.
-->
<resources>
