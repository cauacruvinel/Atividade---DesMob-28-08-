    <!-- Rótulos de Componentes da Interface (UI) -->
    <string name="true_button">Verdadeiro</string>
    <string name="false_button">Falso</string>
    <string name="next_button">Próximo</string>

    <!-- Mensagens de Feedback ao Usuário (Toasts) -->
